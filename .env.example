# Bluesky: create an app password in your Bluesky account settings
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Mastodon: base URL of your instance + OAuth token with write:statuses scope
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Telegram: bot token from @BotFather; add bot as channel admin with permission to post
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# Discord: create a webhook in a channel and keep its URL secret
DISCORD_WEBHOOK_URL=

# DEV.to: generate an API key from account settings
DEVTO_API_KEY=

REQUEST_TIMEOUT_SECONDS=20
